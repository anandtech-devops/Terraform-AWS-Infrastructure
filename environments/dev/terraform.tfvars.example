# Example only. NAT Gateway and RDS are billable resources.
region                   = "ap-south-1"
environment              = "dev"
project                  = "tf-iac-demo"
vpc_cidr                 = "10.10.0.0/16"
az_count                 = 2
enable_nat_gateway       = true
single_nat_gateway       = true
instance_type            = "t3.micro"
asg_min                  = 1
asg_desired              = 1
asg_max                  = 2
enable_rds               = true
db_instance_class        = "db.t3.micro"
db_multi_az              = false
db_backup_retention_days = 1
db_deletion_protection   = false
