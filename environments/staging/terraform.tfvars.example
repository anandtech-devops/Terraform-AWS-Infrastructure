# Example only. Staging is intended as a separate, billable environment.
region                   = "ap-south-1"
environment              = "staging"
project                  = "tf-iac-demo"
vpc_cidr                 = "10.20.0.0/16"
az_count                 = 2
enable_nat_gateway       = true
single_nat_gateway       = true
instance_type            = "t3.small"
asg_min                  = 1
asg_desired              = 2
asg_max                  = 3
enable_rds               = true
db_instance_class        = "db.t3.micro"
db_multi_az              = false
db_backup_retention_days = 1
db_deletion_protection   = false
