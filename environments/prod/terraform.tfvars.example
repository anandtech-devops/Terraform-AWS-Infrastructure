# Example only. Do not deploy prod for a basic portfolio demo without cost/security review.
region                   = "ap-south-1"
environment              = "prod"
project                  = "tf-iac-demo"
vpc_cidr                 = "10.30.0.0/16"
az_count                 = 3
enable_nat_gateway       = true
single_nat_gateway       = false
instance_type            = "t3.medium"
asg_min                  = 2
asg_desired              = 3
asg_max                  = 6
enable_rds               = true
db_instance_class        = "db.t3.micro"
db_multi_az              = true
db_backup_retention_days = 7
db_deletion_protection   = true
